# =========================================================
# TRIPA 환경 변수 예시
#
# 1. 이 파일을 같은 폴더(manage.py 옆)에 .env 이름으로 복사한다.
# 2. 비어 있는 값은 팀원에게 개인 메시지로 받아 채운다.
# 3. .env는 git에 올리지 않는다. 이 파일에는 실제 키 값을 절대 쓰지 않는다.
# 4. 새 키가 생기면 이 파일에 이름을 추가하고 TEAM_UPDATES에 적는다.
#
# 주의: "이름=" 처럼 값을 비워 두면 기본값이 아니라 빈 값으로 읽힌다.
#       기본값을 쓰려면 줄 앞의 # 을 그대로 둔다(# 을 지우면 그 값으로 바뀜).
#
# 값을 바꾼 뒤에는 runserver를 다시 켜야 적용된다.
# =========================================================


# ---------------------------------------------------------
# 기본
# ---------------------------------------------------------

# 로컬 개발은 False (True면 SQLite를 쓰고 SECRET_KEY가 꼭 필요함)
DEPLOY=False

# 로컬 개발은 True, 배포 서버는 False
DEBUG=True

# 로컬은 그대로 두면 개발용 기본값 사용. 배포 서버는 꼭 새로 만든 값을 넣음
# SECRET_KEY=

# 쉼표로 구분. 그대로 두면 127.0.0.1, localhost
# ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS 배포 주소. 로컬은 그대로 둠
# CSRF_TRUSTED_ORIGINS=https://example.com


# ---------------------------------------------------------
# DB (MariaDB)
# ---------------------------------------------------------

DB_NAME=sherpa_schema
DB_USER=sherpa
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306


# ---------------------------------------------------------
# 지도·경로 (브라우저에서 쓰는 키)
# 콘솔에 접속 주소 등록 필요: localhost와 127.0.0.1은 다른 주소로 봄
# ---------------------------------------------------------

# 카카오 JavaScript 키. 없으면 지도가 안 뜸
KAKAO_MAP_API_KEY=

# ODsay Web 키. 없으면 대중교통 경로가 안 나옴
ODSAY_WEB_API_KEY=


# ---------------------------------------------------------
# 서버에서만 쓰는 키 (화면에 넘기지 않음)
# ---------------------------------------------------------

# 카카오 REST 키. 없으면 장소 검색·추천이 안 됨
KAKAO_REST_API_KEY=

# 한국관광공사 TourAPI(공공데이터 포털 일반 인증키, Decoding). 없으면 장소 사진만 안 나옴
TOUR_API_KEY=


# ---------------------------------------------------------
# AI 대화 (OpenAI 호환 API)
# ---------------------------------------------------------

# 없으면 AI 채팅이 안 됨 (Ollama는 필요 없음)
AI_API_KEY=

# 그대로 두면 OpenAI. Ollama는 http://localhost:11434/v1
# AI_BASE_URL=https://api.openai.com/v1

# 그대로 두면 gpt-4o-mini
# AI_MODEL=gpt-4o-mini

# 기본 모델이 바쁠 때 대신 쓸 모델들, 쉼표로 구분
# AI_FALLBACK_MODELS=

# 응답 대기 시간(초)
# AI_TIMEOUT=40


# ---------------------------------------------------------
# 세션·쿠키 (보통은 그대로 둠)
# ---------------------------------------------------------

# 로그인 유지 시간(초, 30분)
# SESSION_COOKIE_AGE=1800

# 요청마다 로그인 시간 연장
# SESSION_SAVE_EVERY_REQUEST=True

# HTTPS 배포 서버만 True
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
